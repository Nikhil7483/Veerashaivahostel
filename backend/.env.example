# Smart Hostel Management System - Environment Configuration Example
# Lingayath Boys Hostel, Krushi Nagar, Shivamogga, Karnataka

# Database Connection (Local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=smart_hostel

# Authentication & Security
# Generate a strong 64-character hex secret for production (e.g., openssl rand -hex 32)
JWT_SECRET_KEY=your_production_grade_jwt_secret_key_change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage
UPLOAD_DIRECTORY=backend/uploads

# CORS Configuration (JSON array or comma-separated URLs of allowed frontend origins)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "https://your-hostel-domain.com"]

# Application Environment (development / production)
ENVIRONMENT=production
